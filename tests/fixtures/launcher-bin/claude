#!/usr/bin/env bash
set -euo pipefail

for forbidden_name in \
  MODEL_ROCKET_DEFAULT_MODEL \
  ANTHROPIC_API_KEY \
  ANTHROPIC_AUTH_TOKEN \
  ANTHROPIC_CUSTOM_HEADERS \
  ANTHROPIC_CUSTOM_MODEL_OPTION_SUPPORTED_CAPABILITIES \
  ANTHROPIC_DEFAULT_FABLE_MODEL \
  ANTHROPIC_DEFAULT_FABLE_MODEL_NAME \
  ANTHROPIC_DEFAULT_FABLE_MODEL_DESCRIPTION \
  ANTHROPIC_DEFAULT_FABLE_MODEL_SUPPORTED_CAPABILITIES \
  ANTHROPIC_DEFAULT_OPUS_MODEL \
  ANTHROPIC_DEFAULT_OPUS_MODEL_NAME \
  ANTHROPIC_DEFAULT_OPUS_MODEL_DESCRIPTION \
  ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES \
  ANTHROPIC_DEFAULT_SONNET_MODEL \
  ANTHROPIC_DEFAULT_SONNET_MODEL_NAME \
  ANTHROPIC_DEFAULT_SONNET_MODEL_DESCRIPTION \
  ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES \
  ANTHROPIC_DEFAULT_HAIKU_MODEL \
  ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME \
  ANTHROPIC_DEFAULT_HAIKU_MODEL_DESCRIPTION \
  ANTHROPIC_DEFAULT_HAIKU_MODEL_SUPPORTED_CAPABILITIES \
  ANTHROPIC_MODEL \
  ANTHROPIC_SMALL_FAST_MODEL \
  CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY \
  CLAUDE_CODE_PROVIDER_MANAGED_BY_HOST \
  CLAUDE_CODE_USE_GATEWAY \
  CLAUDE_CODE_USE_BEDROCK \
  CLAUDE_CODE_USE_VERTEX \
  CLAUDE_CODE_USE_FOUNDRY \
  CLAUDE_CODE_USE_MANTLE \
  CLAUDE_CODE_OAUTH_TOKEN \
  CLAUDE_CODE_OAUTH_REFRESH_TOKEN \
  CLAUDE_CODE_OAUTH_SCOPES \
  CLAUDE_CODE_SUBAGENT_MODEL; do
  if [[ -n "${!forbidden_name:-}" ]]; then
    echo "Claude inherited forbidden routing variable $forbidden_name" >&2
    exit 74
  fi
done
for forbidden_proxy_name in \
  HTTP_PROXY HTTPS_PROXY ALL_PROXY \
  http_proxy https_proxy all_proxy; do
  if [[ -n "${!forbidden_proxy_name:-}" ]]; then
    echo "Claude inherited forbidden proxy variable $forbidden_proxy_name" >&2
    exit 87
  fi
done
if [[ "${1:-}" == "--version" ]]; then
  if [[ "${MODEL_ROCKET_TEST_REPLACE_ON_VERSION:-}" == "1" ]]; then
    if [[ "$0" == */tests/fixtures/launcher-bin/claude ]]; then
      echo "Refusing to mutate the tracked Claude fixture" >&2
      exit 88
    fi
    printf '%s\n' '# replaced after version validation' >>"$0"
  fi
  printf '%s\n' "2.1.999 (Claude Code)"
  exit 0
fi
if [[ ! "${ANTHROPIC_BASE_URL:-}" =~ ^http://127\.0\.0\.1:[0-9]+/[0-9a-f]{64}$ ]]; then
  echo "Claude did not receive a loopback router URL" >&2
  exit 76
fi
if [[ "${ANTHROPIC_CUSTOM_MODEL_OPTION:-}" != "anthropic-model-rocket-gpt-5.6-sol-normal-high" ]]; then
  echo "Claude did not receive the canonical GPT custom model" >&2
  exit 78
fi
if [[ "${CLAUDE_CODE_MAX_CONTEXT_TOKENS:-}" != "272000" ]]; then
  echo "Claude did not receive the GPT context window" >&2
  exit 80
fi
for required_bypass in localhost 127.0.0.1 ::1 '[::1]' existing-upper.example existing-lower.example; do
  if [[ ",${NO_PROXY:-}," != *",${required_bypass},"* ]]; then
    echo "NO_PROXY is missing $required_bypass" >&2
    exit 83
  fi
  if [[ ",${no_proxy:-}," != *",${required_bypass},"* ]]; then
    echo "no_proxy is missing $required_bypass" >&2
    exit 84
  fi
done
if [[ "${1:-}" != "--model" || "${2:-}" != "claude-fable-5" ]]; then
  echo "Claude did not start with Fable as the lead model" >&2
  exit 79
fi

settings_file=""
while (($#)); do
  if [[ "$1" == "--settings" ]]; then
    shift
    settings_file="${1:-}"
    break
  fi
  shift
done
if [[ -z "$settings_file" || ! -f "$settings_file" ]]; then
  echo "Claude did not receive a routing settings file" >&2
  exit 82
fi

python3 - "$settings_file" <<'PY'
import json
import os
import stat
import sys

settings_file = sys.argv[1]
with open(settings_file, encoding="utf-8") as settings_handle:
    command_settings = json.load(settings_handle)
with open(".claude/settings.json", encoding="utf-8") as settings_handle:
    lower_settings = json.load(settings_handle)

merged_settings = lower_settings | command_settings
merged_settings["env"] = lower_settings.get("env", {}) | command_settings.get("env", {})
merged_settings["availableModels"] = list(dict.fromkeys(
    lower_settings.get("availableModels", []) + command_settings.get("availableModels", [])
))
routing = merged_settings["env"]
if merged_settings.get("apiKeyHelper") != "":
    raise SystemExit("routing settings do not neutralize a lower apiKeyHelper")
if merged_settings.get("fallbackModel") != []:
    raise SystemExit("routing settings do not disable lower fallback models")
config_hooks = command_settings.get("hooks", {}).get("ConfigChange", [])
if len(config_hooks) != 1:
    raise SystemExit("routing settings do not contain the ConfigChange guard")
guard = config_hooks[0]
if guard.get("matcher") != "user_settings|project_settings|local_settings":
    raise SystemExit("ConfigChange guard has the wrong matcher")
guard_command = guard.get("hooks", [{}])[0].get("command", "")
if not guard_command.endswith(" guard-settings-change"):
    raise SystemExit("ConfigChange guard does not invoke the settings guard")
required_models = {
    "fable",
    "opus",
    "sonnet",
    "haiku",
    "anthropic-model-rocket-gpt-5.6-sol-normal-low",
    "anthropic-model-rocket-gpt-5.6-sol-normal-high",
    "anthropic-model-rocket-gpt-5.6-sol-fast-low",
    "anthropic-model-rocket-gpt-5.6-sol-fast-high",
}
if not required_models.issubset(merged_settings.get("availableModels", [])):
    raise SystemExit("routing settings do not preserve required model choices")
base_url = routing.get("ANTHROPIC_BASE_URL", "")
if not base_url.startswith("http://127.0.0.1:") or len(base_url.rsplit("/", 1)[-1]) != 64:
    raise SystemExit("routing settings do not contain the loopback URL")
for forbidden in (
    "ANTHROPIC_API_KEY",
    "ANTHROPIC_AUTH_TOKEN",
    "ANTHROPIC_CUSTOM_HEADERS",
    "ANTHROPIC_CUSTOM_MODEL_OPTION_SUPPORTED_CAPABILITIES",
    "ANTHROPIC_DEFAULT_FABLE_MODEL",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_NAME",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_DESCRIPTION",
    "ANTHROPIC_DEFAULT_FABLE_MODEL_SUPPORTED_CAPABILITIES",
    "ANTHROPIC_DEFAULT_OPUS_MODEL",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_NAME",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_DESCRIPTION",
    "ANTHROPIC_DEFAULT_OPUS_MODEL_SUPPORTED_CAPABILITIES",
    "ANTHROPIC_DEFAULT_SONNET_MODEL",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_NAME",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_DESCRIPTION",
    "ANTHROPIC_DEFAULT_SONNET_MODEL_SUPPORTED_CAPABILITIES",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_NAME",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_DESCRIPTION",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL_SUPPORTED_CAPABILITIES",
    "ANTHROPIC_MODEL",
    "ANTHROPIC_SMALL_FAST_MODEL",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY",
    "CLAUDE_CODE_PROVIDER_MANAGED_BY_HOST",
    "CLAUDE_CODE_USE_GATEWAY",
    "CLAUDE_CODE_USE_BEDROCK",
    "CLAUDE_CODE_USE_VERTEX",
    "CLAUDE_CODE_USE_FOUNDRY",
    "CLAUDE_CODE_USE_MANTLE",
    "CLAUDE_CODE_OAUTH_TOKEN",
    "CLAUDE_CODE_OAUTH_REFRESH_TOKEN",
    "CLAUDE_CODE_OAUTH_SCOPES",
    "CLAUDE_CODE_SUBAGENT_MODEL",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "ALL_PROXY",
    "http_proxy",
    "https_proxy",
    "all_proxy",
):
    if routing.get(forbidden) != "":
        raise SystemExit(f"routing settings do not neutralize lower {forbidden}")
if routing.get("ANTHROPIC_CUSTOM_MODEL_OPTION") != "anthropic-model-rocket-gpt-5.6-sol-normal-high":
    raise SystemExit("routing settings do not contain the canonical GPT model")
if routing.get("ANTHROPIC_CUSTOM_MODEL_OPTION_NAME") != "GPT-5.6 Sol Normal - High thinking":
    raise SystemExit("routing settings do not contain the canonical GPT model label")
if routing.get("ANTHROPIC_CUSTOM_MODEL_OPTION_DESCRIPTION") != "Standard delivery with high reasoning through Codex subscription":
    raise SystemExit("routing settings do not contain the canonical GPT model description")
if routing.get("CLAUDE_CODE_MAX_CONTEXT_TOKENS") != "272000":
    raise SystemExit("routing settings do not contain the GPT context window")
for name in ("NO_PROXY", "no_proxy"):
    bypasses = routing.get(name, "").split(",")
    for required in ("localhost", "127.0.0.1", "::1", "[::1]", "existing-upper.example", "existing-lower.example"):
        if required not in bypasses:
            raise SystemExit(f"routing settings {name} does not contain {required}")
if stat.S_IMODE(os.stat(settings_file).st_mode) != 0o600:
    raise SystemExit("routing settings permissions are not 0600")
catalogue_snapshot = os.environ.get("MODEL_ROCKET_CONFIG", "")
if not catalogue_snapshot or not os.path.isfile(catalogue_snapshot):
    raise SystemExit("model catalogue snapshot is missing")
if stat.S_IMODE(os.stat(catalogue_snapshot).st_mode) != 0o600:
    raise SystemExit("model catalogue snapshot permissions are not 0600")
PY

printf '%s\n%s\n%s\n' \
  "launcher environment isolated" \
  "$settings_file" \
  "$MODEL_ROCKET_CONFIG" >"$LAUNCHER_PROOF_FILE"

exit "${MODEL_ROCKET_TEST_CLAUDE_EXIT_STATUS:-0}"
